# Academics Environment Configuration
# Copy this file to .env and customize for your environment

# Application
APP_ENV=local
APP_DOMAIN=academics.local
APP_URL=http://academics.local
APP_DEBUG=false
APP_SUPPORT_EMAIL=support@academics.app

# Database (Localhost / XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=edusphere
DB_NAME_TEST=edusphere_test

# Production Database (InfinityFree / Shared Hosting)
# IS_PRODUCTION=1
# DB_HOST=sql.infinityfree.com
# DB_PORT=3306
# DB_USER=if0_12345678
# DB_PASS=your_password
# DB_NAME=if0_12345678_edusphere

# Redis (Optional - for caching and sessions)
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# SMTP (used for password reset email delivery)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=support@yourdomain.com
MAIL_FROM_NAME="Academics Platform"

# Security
SESSION_LIFETIME=1800
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=10
REQUIRE_MIXED_CASE_PASSWORD=1
REQUIRE_NUMBER_PASSWORD=1

# Web Push (VAPID keys - generate with: php includes/push.php generate)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@academics.app

# File Storage
# FILESYSTEM_DRIVER=local
# AWS_S3_KEY=
# AWS_S3_SECRET=
# AWS_S3_REGION=us-east-1
# AWS_S3_BUCKET=academics-files