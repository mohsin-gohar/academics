# Academics School Management Platform Configuration
# Copy this file to .env or update config/db.php directly

APP_NAME="Academics"
APP_SUPPORT_EMAIL="support@academics.app"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/student-task-manager
APP_TIMEZONE=Asia/Karachi

# Base domain used for school subdomains (e.g. academics.com).
# Leave empty to auto-detect the first label of any three-part hostname.
APP_DOMAIN=

# Database Credentials (Default XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=edusphere
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Security Settings
SESSION_LIFETIME=1800
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
